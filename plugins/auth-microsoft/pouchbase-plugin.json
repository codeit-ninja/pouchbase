{
	"$schema": "https://pouchbase.io/schemas/plugin-manifest.json",
	"apiVersion": 1,
	"id": "auth-microsoft",
	"name": "Microsoft sign-in",
	"categories": ["auth"],
	"engines": {
		"pouchbase": ">=0.8.0"
	},
	"permissions": {
		"network": ["graph.microsoft.com"]
	},
	"server": "server/index.ts",
	"contributes": {
		"authProviders": [
			{
				"id": "microsoft",
				"label": "Microsoft",
				"consoleUrl": "https://entra.microsoft.com/#view/Microsoft_AAD_RegisteredApps/ApplicationsListBlade",
				"icon": "ui/microsoft.svg"
			}
		]
	}
}
