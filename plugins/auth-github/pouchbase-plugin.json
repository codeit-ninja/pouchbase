{
	"$schema": "https://pouchbase.io/schemas/plugin-manifest.json",
	"apiVersion": 1,
	"id": "auth-github",
	"name": "GitHub sign-in",
	"categories": ["auth"],
	"engines": {
		"pouchbase": ">=0.8.0"
	},
	"permissions": {
		"network": ["api.github.com"]
	},
	"server": "server/index.ts",
	"contributes": {
		"authProviders": [
			{
				"id": "github",
				"label": "GitHub",
				"consoleUrl": "https://github.com/settings/developers",
				"icon": "ui/github.svg"
			}
		]
	}
}
