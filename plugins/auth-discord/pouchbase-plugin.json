{
	"$schema": "https://pouchbase.io/schemas/plugin-manifest.json",
	"apiVersion": 1,
	"id": "auth-discord",
	"name": "Discord sign-in",
	"categories": ["auth"],
	"engines": {
		"pouchbase": ">=0.8.0"
	},
	"permissions": {
		"network": ["discord.com"]
	},
	"server": "server/index.ts",
	"contributes": {
		"authProviders": [
			{
				"id": "discord",
				"label": "Discord",
				"consoleUrl": "https://discord.com/developers/applications",
				"icon": "ui/discord.svg"
			}
		]
	}
}
