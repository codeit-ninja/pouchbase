# The Pouchbase instance to test against; `pnpm pouchbase:up` serves one on 4300 (docker-compose.yml).
VITE_POUCHBASE_URL=http://localhost:4300

# Cloudflare credentials for the Docker instance, when the `.env` at the repository root has none.
# CLOUDFLARE_ACCOUNT_ID=
# CLOUDFLARE_API_TOKEN=

# The admin the Docker instance installs itself with (defaults: admin@pouchbase.test, pouchbase-test).
# POUCHBASE_ADMIN_EMAIL=
# POUCHBASE_ADMIN_PASSWORD=
