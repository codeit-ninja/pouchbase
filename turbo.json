{
	"$schema": "https://turborepo.com/schema.json",
	"ui": "tui",
	"tasks": {
		"build": {
			"dependsOn": ["^build"],
			"inputs": ["$TURBO_DEFAULT$", ".env*"],
			"outputs": [".svelte-kit/**", "dist/**", "build/**"]
		},
		"check": {
			"dependsOn": ["^build"]
		},
		"lint": {},
		"format": {
			"cache": false
		},
		"dev": {
			"cache": false,
			"persistent": true
		}
	}
}
