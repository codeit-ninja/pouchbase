# Copy to `.env` and fill in; `.env` and `.env.*` are listed in .gitignore.
#
# The Pouchbase instance that holds the plugin registry and the accounts (see README.md, "Setting up
# the instance"), and an API key of it with the service scope.
POUCHBASE_URL=https://api.pouchbase.io
POUCHBASE_SERVICE_KEY=

# To work against the development registry instead of the live one, put the same two variables in
# `.env.development.local`: `pnpm dev` reads it on top of `.env`, builds don't.
#
# POUCHBASE_URL=http://localhost:5175
# POUCHBASE_SERVICE_KEY=pbk_…   (a service key of the development instance)
