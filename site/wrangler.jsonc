{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"name": "pouchbase-site",
	"compatibility_date": "2026-10-21",
	"compatibility_flags": ["nodejs_als"],
	"main": ".svelte-kit/cloudflare/_worker.js",
	"assets": {
		"binding": "ASSETS",
		"directory": ".svelte-kit/cloudflare"
	},
	// The registry API on the host of the instance behind the site: a route takes precedence over
	// the instance's custom domain, so only `/v1` reaches this Worker (see README.md).
	"routes": [{ "pattern": "api.pouchbase.io/v1/*", "zone_name": "pouchbase.io" }],
	"workers_dev": true,
	"preview_urls": true
}
