{
	"name": "@pouchbasejs/ui",
	"version": "0.1.0",
	"description": "Svelte 5 UI components of the Pouchbase dashboard, for the app and for plugins",
	"license": "MIT",
	"type": "module",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/pouchbase/pouchbase.git",
		"directory": "packages/ui"
	},
	"homepage": "https://pouchbase.io",
	"keywords": [
		"pouchbase",
		"svelte",
		"components",
		"ui"
	],
	"files": [
		"dist"
	],
	"exports": {
		".": {
			"types": "./src/index.ts",
			"svelte": "./src/index.ts",
			"default": "./src/index.ts"
		},
		"./theme.css": "./src/theme.css",
		"./vite": {
			"types": "./src/vite/iconify.ts",
			"default": "./src/vite/iconify.ts"
		},
		"./package.json": "./package.json",
		"./*": {
			"types": "./src/components/*/index.ts",
			"svelte": "./src/components/*/index.ts",
			"default": "./src/components/*/index.ts"
		}
	},
	"publishConfig": {
		"access": "public",
		"exports": {
			".": {
				"types": "./dist/index.d.ts",
				"svelte": "./dist/index.js",
				"default": "./dist/index.js"
			},
			"./theme.css": "./dist/theme.css",
			"./vite": {
				"types": "./dist/vite/iconify.d.ts",
				"default": "./dist/vite/iconify.js"
			},
			"./package.json": "./package.json",
			"./*": {
				"types": "./dist/components/*/index.d.ts",
				"svelte": "./dist/components/*/index.js",
				"default": "./dist/components/*/index.js"
			}
		}
	},
	"scripts": {
		"build": "svelte-package --input src --output dist",
		"check": "svelte-check --tsconfig ./tsconfig.json",
		"prepublishOnly": "pnpm build"
	},
	"peerDependencies": {
		"@iconify/svelte": "^5.0.0",
		"bits-ui": "^2.0.0",
		"svelte": "^5.0.0",
		"tailwindcss": "^4.0.0",
		"vite": ">=7.0.0"
	},
	"peerDependenciesMeta": {
		"tailwindcss": {
			"optional": true
		},
		"vite": {
			"optional": true
		}
	},
	"dependencies": {
		"@iconify/types": "^2.0.0",
		"@iconify/utils": "^3.1.7"
	},
	"devDependencies": {
		"@iconify/svelte": "^5.2.3",
		"@sveltejs/package": "^3.0.1",
		"@types/node": "^22.20.5",
		"bits-ui": "^2.20.2",
		"svelte": "^5.57.2",
		"svelte-check": "^4.7.7",
		"tailwindcss": "^4.3.3",
		"typescript": "^6.0.3",
		"vite": "^8.3.5"
	}
}
