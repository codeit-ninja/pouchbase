{
	"name": "pouchbase",
	"private": true,
	"version": "0.4.0",
	"license": "AGPL-3.0-only",
	"type": "module",
	"packageManager": "pnpm@12.15.0",
	"scripts": {
		"dev": "pnpm run \"/^dev:/\"",
		"dev:app": "vite dev",
		"dev:site": "pnpm --filter pouchbase-site dev",
		"build": "wrangler types --check && vite build && node scripts/worker-entry.mjs",
		"build:node": "cross-env POUCHBASE_TARGET=node vite build",
		"build:binary": "pnpm build:node && node scripts/build-binary.mjs",
		"preview": "wrangler dev .svelte-kit/cloudflare/_worker.js --port 4173",
		"preview:node": "node server.mjs",
		"prepare": "svelte-kit sync || echo ''",
		"check": "wrangler types --check && svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write .",
		"gen": "wrangler types",
		"db:generate": "drizzle-kit generate && prettier --write drizzle",
		"cf:whoami": "wrangler whoami",
		"seed:test-users": "node scripts/seed-test-users.mjs",
		"changeset": "changeset",
		"changeset:version": "changeset version",
		"release": "node scripts/publish-packages.mjs"
	},
	"devDependencies": {
		"@changesets/changelog-github": "^1.0.1",
		"@changesets/cli": "^3.0.3",
		"@eslint/js": "^10.0.1",
		"@iconify-json/logos": "^1.2.17",
		"@iconify-json/lucide": "^1.2.147",
		"@iconify/svelte": "^5.2.3",
		"@iconify/types": "^2.0.0",
		"@iconify/utils": "^3.1.7",
		"@internationalized/date": "^3.12.4",
		"@pouchbasejs/plugin-sdk": "workspace:*",
		"@sveltejs/adapter-cloudflare": "^8.0.1",
		"@sveltejs/adapter-node": "^6.0.0",
		"@sveltejs/kit": "^3.1.0",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"@tailwindcss/typography": "^0.5.20",
		"@tailwindcss/vite": "^4.3.3",
		"@tiptap/core": "^3.32.0",
		"@tiptap/extensions": "^3.32.0",
		"@tiptap/markdown": "^3.32.0",
		"@tiptap/pm": "^3.32.0",
		"@tiptap/starter-kit": "^3.32.0",
		"@types/node": "^22.20.5",
		"bits-ui": "^2.20.2",
		"cross-env": "^10.1.0",
		"drizzle-kit": "^0.31.11",
		"eslint": "^10.13.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.23.1",
		"globals": "^17.13.0",
		"prettier": "^3.9.10",
		"prettier-plugin-svelte": "^4.1.1",
		"prettier-plugin-tailwindcss": "^0.8.1",
		"rolldown": "1.2.15",
		"runed": "^0.37.1",
		"svelte": "^5.57.2",
		"svelte-check": "^4.7.7",
		"tailwindcss": "^4.3.3",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.72.0",
		"vite": "^8.3.5",
		"wrangler": "^4.152.0"
	},
	"imports": {
		"#lib": "./src/lib/index.js",
		"#lib/*": "./src/lib/*"
	},
	"dependencies": {
		"@cf-wasm/photon": "0.4.0",
		"@cf-wasm/quickjs": "0.3.0",
		"aws4fetch": "1.0.20",
		"drizzle-orm": "^0.45.4",
		"jose": "^6.2.13",
		"monaco-editor": "0.57.0",
		"neverthrow": "8.2.0",
		"zod": "^4.6.7"
	}
}
