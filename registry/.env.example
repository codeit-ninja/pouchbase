# Copy to `.env` and fill in; `.env` is listed in .gitignore.
#
# The development instance of the plugin registry. Like every Pouchbase instance it keeps its data on
# Cloudflare (D1 and R2), in databases named after the instance, so it never touches the live
# registry's data. The same credentials as the root `.env` work.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

# Name of the instance on the Cloudflare account (lowercase, digits and dashes, at most 19
# characters). Keep it different from the root `.env` and from the live registry.
POUCHBASE_INSTANCE=registry-dev

# Where it runs. The site's dev server runs on 5174 and the app's on 5173.
PORT=5175
ORIGIN=http://localhost:5175

# Optional: install without the install page on the first request.
# POUCHBASE_ADMIN_EMAIL=
# POUCHBASE_ADMIN_PASSWORD=
