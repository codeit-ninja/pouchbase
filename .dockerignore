.dockerignore

# The site and the test app aren't part of the image; only their package.json (for the lockfile). Of
# the JS SDK only the sources are needed: the dashboard bundles its realtime client.
site/*
!site/package.json
test-app/*
!test-app/package.json
packages/js-sdk/*
!packages/js-sdk/package.json
!packages/js-sdk/src
