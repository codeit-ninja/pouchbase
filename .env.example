# Copy to `.env` and fill in; `.env` is listed in .gitignore.
#
# Pouchbase stores its data on Cloudflare (D1 and R2) and runs either as a Cloudflare Worker or as
# a Node server (Docker, a VPS). Both need the Cloudflare credentials below. The build target is
# chosen with POUCHBASE_TARGET (see vite.config.ts): `cloudflare` (default) or `node`.
# POUCHBASE_TARGET=node

# ── Cloudflare ─────────────────────────────────────────────────────────────────────────────────────
# Used by wrangler, by the app itself and by docker compose. The install wizard creates the
# `pouchbase` D1 database through the Cloudflare API and the app queries D1 through the HTTP API
# afterwards; a deployed Worker adds D1 bindings to itself for faster queries. Wrangler reads
# these variables from `.env` automatically.

# Account ID: dashboard → Workers & Pages → right column "Account ID"
CLOUDFLARE_ACCOUNT_ID=

# API token: dashboard → My Profile → API Tokens → Create Token
# (template "Edit Cloudflare Workers" + Account → D1 → Edit + Account → Workers R2 Storage → Edit)
# To send mail with Cloudflare Email Service (Settings → Mail), add Account → Email Sending → Edit.
# On Workers, `pnpm wrangler deploy --secrets-file .env` stores them as Worker secrets.
CLOUDFLARE_API_TOKEN=

# ── Node runtime only ──────────────────────────────────────────────────────────────────────────────
# The public URL of the instance, required for redirects and OAuth callbacks (see server.mjs).
# ORIGIN=http://localhost:3000

# ── Plugins ────────────────────────────────────────────────────────────────────────────────────────
# Registry the Plugins page searches and installs from; defaults to https://plugins.pouchbase.io.
# While developing a plugin, use the local registry that `pouchbase-plugin dev` prints.
# PLUGIN_REGISTRY_URL=http://localhost:4510

# ── Debugging ──────────────────────────────────────────────────────────────────────────────────────
# Logs the duration of every request (`[req]`) and every database round-trip (`[db]`, with `binding`
# or `api` for how it was sent), to find out what makes a page slow. Works on every runtime; on
# Workers, read the logs with `wrangler tail`.
# POUCHBASE_LOG_TIMING=true
