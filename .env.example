# Cloudflare account credentials for wrangler and for the app itself.
# The install wizard uses them to create the `pouchbase` D1 database through the Cloudflare API,
# and the app queries D1 through the HTTP API afterwards (there is no D1 binding).
# Copy to `.env` and fill in; `.env` is listed in .gitignore.
# Wrangler reads these variables from `.env` in the project root automatically.

# Account ID: dashboard → Workers & Pages → right column "Account ID"
CLOUDFLARE_ACCOUNT_ID=

# API token: dashboard → My Profile → API Tokens → Create Token
# (template "Edit Cloudflare Workers" + Account → D1 → Edit; D1 Edit is required by the app)
# In production, set them as Worker secrets: `pnpm wrangler secret put CLOUDFLARE_API_TOKEN`
# (and the same for CLOUDFLARE_ACCOUNT_ID).
CLOUDFLARE_API_TOKEN=
